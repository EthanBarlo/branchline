{
  "name": "branchline",
  "version": "0.10.0",
  "private": true,
  "description": "Local code review across repositories and submodules",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:desktop:jira": "node scripts/smoke-jira.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:desktop:updates": "node scripts/smoke-updates.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.4.1",
    "@pierre/trees": "1.0.0-beta.6",
    "electron-log": "5.4.3",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "js-yaml": "4.3.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "dev.branchline.desktop",
    "productName": "Branchline",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-universal.${ext}",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "EthanBarlo",
      "repo": "branchline",
      "private": false,
      "releaseType": "draft"
    }
  }
}
