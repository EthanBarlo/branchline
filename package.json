{
  "name": "branchline",
  "version": "0.13.0",
  "private": true,
  "description": "Local code review across repositories and submodules",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "test:desktop:git": "node scripts/smoke-git-workflow.mjs",
    "test:desktop:git-history": "node scripts/smoke-git-history.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run routes:generate && tsc --noEmit && npm run lint && npm run format:check && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:desktop:background-review": "node scripts/smoke-background-review.mjs",
    "test:desktop:jira": "node scripts/smoke-jira.mjs",
    "test:desktop:integrations": "node scripts/smoke-integrations.mjs",
    "test:desktop:integration-backend": "node scripts/smoke-integration-backend.mjs",
    "typecheck": "npm run routes:generate && tsc --noEmit",
    "lint:styles": "eslint src --ext .ts,.tsx",
    "package": "npm run build && node scripts/package-local.mjs",
    "dist": "npm run build && electron-builder",
    "test:desktop:updates": "node scripts/smoke-updates.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:desktop:jira-browser": "node scripts/smoke-jira-browser.mjs",
    "format": "prettier --write src electron shared",
    "format:check": "prettier --check src electron shared",
    "routes:generate": "node scripts/generate-routes.mjs",
    "test:desktop:routing": "node scripts/smoke-routing.mjs",
    "lint": "eslint src electron shared --ext .ts,.tsx",
    "test:desktop:performance": "node scripts/smoke-performance.mjs",
    "benchmark:performance": "node --import tsx scripts/benchmark-performance.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.4.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-router": "^1.170.39",
    "electron-log": "5.4.3",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/router-generator": "^1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.11.0",
    "js-yaml": "4.3.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "dev.branchline.desktop",
    "productName": "Branchline",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-universal.${ext}",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "EthanBarlo",
      "repo": "branchline",
      "private": false,
      "releaseType": "draft"
    }
  }
}
